pipeline {
    agent any

    environment{
        GOPATH = "${WORKSPACE}/.go"
        GOCACHE = "${WORKSPACE}/.cache"
    }

    stages{
       stage('Unit Tests - Backend'){
            agent{
                docker{
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            steps{
                dir('bugtracker-backend'){
                    sh 'go mod download'
                    //sh 'go test -v ./...'
                    sh 'go test ./... -v 2>&1 | go run github.com/jstemmer/go-junit-report/v2@latest > test-backend-results.xml'
                }
            }
            post{
                always{
                    junit 'bugtracker-backend/test-backend-results.xml'
                    dir('bugtracker-backend'){
                        //run test coverage for backend
                        sh 'go test -coverprofile=coverage.out -covermode=atomic ./...'
                        //convert that test coverage result to html file
                        sh 'go tool cover -html=coverage.out -o coverage.html'
                        publishHTML(target: [
                            allowMissing: false,
                            alwaysLinkToLastBuild: true,
                            keepAll: true, // Giữ lại lịch sử báo cáo của TẤT CẢ các lượt build
                            reportDir: '.', // Thư mục chứa file HTML
                            reportFiles: 'coverage.html',
                            reportName: 'Go Code Coverage Report' // Tên hiển thị trên menu Jenkins
                        ])
                    }
                }
            }
       }
       stage('Unit Tests - Frontend'){
            agent{
                docker{
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps{
                dir('bugtracker-frontend'){
                    sh '''
                        npm ci
                        npm test
                    '''
                }
            }
            post{
                always{
                    junit 'bugtracker-frontend/test-results.xml'
                }
            }
       }
    }
}
